{
  "name": "know-os",
  "version": "0.1.0",
  "private": true,
  "description": "KNOW/OS — Personal Learning Operating System",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "packs:verify": "node scripts/verify-pack-catalog.mjs",
    "generate:tokens": "node scripts/generate-design-tokens.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "node scripts/run-real-postgres-test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "pnpm generate:tokens && next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "security:audit": "pnpm audit --prod --audit-level moderate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.28.0",
    "motion": "13.4.6",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "quickjs-emscripten": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "tsx": "^4.23.15"
  }
}

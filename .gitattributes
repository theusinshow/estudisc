# Preserve sealed draft bytes and upstream hashes across Windows/Linux checkouts.
packs/drafts/ifsc-2027-science/** -text whitespace=cr-at-eol
packs/drafts/ifsc-2027-gh/** -text whitespace=cr-at-eol
packs/drafts/ifsc-2027-gh/source/** whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Upstream Markdown line breaks/EOF whitespace are preserved, not reformatted.
packs/drafts/ifsc-2027-science/source/** whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Preserve the sealed SVG descriptions exactly as initially validated.
packs/drafts/ifsc-2027-science/media/*.svg whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Existing seed figures are embedded verbatim in the tracked Week 1 release.
packs/seeds/ifsc-2027.lesson-drafts/figures/**/*.svg text eol=lf
# These three existing figures were embedded with CRLF in the immutable release.
packs/seeds/ifsc-2027.lesson-drafts/figures/GH-01/mapa-escala.svg text eol=crlf
packs/seeds/ifsc-2027.lesson-drafts/figures/GH-01/mercator.svg text eol=crlf
packs/seeds/ifsc-2027.lesson-drafts/figures/GH-01/seculos.svg text eol=crlf

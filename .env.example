# Application
NEXT_PUBLIC_APP_NAME=KNOW/OS
APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/know_os

# Authentication — production values come from Vercel/Google OAuth, never commit real secrets
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
KNOW_OS_ALLOWED_GOOGLE_EMAILS=you@example.com
KNOW_OS_ADMIN_GOOGLE_EMAILS=you@example.com

# Development owner only — production derives a distinct owner from each approved Google identity
KNOW_OS_OWNER_ID=local-owner
# Dev-created code accounts (ADR 0031). Leave empty for Google OAuth / local owner.
# Create with: node scripts/create-account.mjs "Nome" 123456 [--admin]  (needs AUTH_SECRET >= 32 chars)
KNOW_OS_ACCOUNTS=

# Optional AI generation — server-side only; never expose this as NEXT_PUBLIC_*
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Optional observability placeholders
LOG_LEVEL=info

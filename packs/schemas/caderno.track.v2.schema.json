{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://know-os.local/schemas/caderno.track.v2.schema.json",
  "title": "Caderno Track Pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packId",
    "version",
    "language",
    "track"
  ],
  "properties": {
    "schema": {
      "const": "caderno.track.v2"
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "track": {
      "$ref": "#/$defs/track"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "default": []
    },
    "curriculumRequirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/curriculumRequirement"
      },
      "default": []
    },
    "conceptPrerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conceptPrerequisite"
      },
      "default": []
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "default": []
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "richContent": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "official_curriculum",
            "official_exam",
            "reference",
            "human_created",
            "ai_generated"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "object",
          "additionalProperties": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "modules"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "lessons"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "subjectCode": {
          "type": "string",
          "minLength": 1
        },
        "lessons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "kind",
        "concepts",
        "blocks",
        "activities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "core",
            "compact",
            "practice",
            "synthesis"
          ]
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "status": {
          "enum": [
            "draft",
            "review",
            "approved",
            "published",
            "retired"
          ]
        },
        "concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/concept"
          },
          "minItems": 1
        },
        "prerequisiteConceptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activity"
          }
        },
        "exitTicketQuestionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "importance": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "payload"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "text",
            "concept",
            "note",
            "warning",
            "code",
            "example",
            "prediction",
            "summary",
            "worked-example",
            "numeric-explorer",
            "guided-steps",
            "text-highlight",
            "classification",
            "ordering",
            "timeline",
            "diagram",
            "graph",
            "table",
            "map",
            "hotspot",
            "matching",
            "exit-ticket"
          ]
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "conceptIds",
        "prompt",
        "config"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "prediction",
            "multiple-choice",
            "explain",
            "code",
            "debug",
            "numeric",
            "ordering",
            "classification",
            "matching",
            "text-highlight",
            "guided-steps",
            "question"
          ]
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prompt": {
          "$ref": "#/$defs/richContent"
        },
        "questionId": {
          "$ref": "#/$defs/id"
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        },
        "evaluatorVersion": {
          "type": "string"
        }
      }
    },
    "curriculumRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subjectCode",
        "label",
        "sourceId",
        "mappedConceptIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parentId": {
          "$ref": "#/$defs/id"
        },
        "subjectCode": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "sourceLocator": {
          "type": "object",
          "additionalProperties": true
        },
        "mappedConceptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "unmapped",
            "mapped",
            "covered",
            "validated"
          ]
        }
      }
    },
    "conceptPrerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conceptId",
        "prerequisiteConceptId",
        "strength"
      ],
      "properties": {
        "conceptId": {
          "$ref": "#/$defs/id"
        },
        "prerequisiteConceptId": {
          "$ref": "#/$defs/id"
        },
        "strength": {
          "enum": [
            "required",
            "recommended"
          ]
        }
      }
    },
    "questionChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "content",
        "correct"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "content": {
          "$ref": "#/$defs/richContent"
        },
        "correct": {
          "type": "boolean"
        },
        "targetsError": {
          "enum": [
            "conceptual",
            "procedural",
            "calculation",
            "interpretation",
            "prerequisite",
            "distractor",
            "attention",
            "memory",
            "unknown"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "subjectCode",
        "primaryConceptId",
        "conceptIds",
        "type",
        "difficulty",
        "cognitiveOperations",
        "stem",
        "answer",
        "provenance",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "subjectCode": {
          "type": "string",
          "minLength": 1
        },
        "primaryConceptId": {
          "$ref": "#/$defs/id"
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "type": {
          "enum": [
            "multiple_choice",
            "numeric",
            "ordering",
            "classification",
            "matching"
          ]
        },
        "difficulty": {
          "enum": [
            "foundation",
            "direct",
            "applied",
            "ifsc",
            "challenge"
          ]
        },
        "cognitiveOperations": {
          "type": "array",
          "items": {
            "enum": [
              "recall",
              "identify",
              "interpret",
              "calculate",
              "compare",
              "infer",
              "apply",
              "analyze",
              "evaluate"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "stimulus": {
          "$ref": "#/$defs/richContent"
        },
        "stem": {
          "$ref": "#/$defs/richContent"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/questionChoice"
          }
        },
        "answer": {
          "type": "object",
          "additionalProperties": true
        },
        "explanation": {
          "$ref": "#/$defs/richContent"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "official_exam",
                "generated",
                "human_created",
                "derived"
              ]
            },
            "examId": {
              "$ref": "#/$defs/id"
            },
            "officialNumber": {
              "type": "integer",
              "minimum": 1
            },
            "generationRunId": {
              "type": "string"
            },
            "derivedFromQuestionId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "exposurePolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimumDaysBetween": {
              "type": "integer",
              "minimum": 0
            },
            "maximumTrainingExposures": {
              "type": "integer",
              "minimum": 0
            },
            "reservedForAssessment": {
              "type": "boolean"
            },
            "unlockAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "status": {
          "enum": [
            "draft",
            "auto_validated",
            "in_review",
            "approved",
            "published",
            "retired",
            "annulled"
          ]
        }
      }
    }
  }
}

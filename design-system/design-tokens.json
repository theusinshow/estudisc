{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$changelog": [
    {
      "version": "4.1.0",
      "date": "2026-10-16",
      "changes": [
        "ADR 0067 Caderno de prova: three elevation levels (structure/surface/action), contrasted type scale with Archivo wdth axis, reading measure, exam-grid pattern, layout grid and state-communicating motion tokens (UI 150–250 ms, press 90 ms, stamp, question slide); focus ring 3px as already rendered"
      ]
    },
    {
      "version": "4.0.0",
      "date": "2026-10-01",
      "changes": [
        "ADR 0030 neo-brutalist refresh: saturated subject palette, 3px ink rules, deeper solid shadows, rounder radii, loaded Archivo/JetBrains Mono"
      ]
    },
    {
      "version": "3.0.0",
      "date": "2026-10-01",
      "changes": [
        "Added mobile learning surface, answer and navigation tokens; preserved existing semantic and technical tokens"
      ]
    },
    {
      "version": "2.2.0",
      "date": "2026-08-04",
      "changes": [
        "Added scoped product-area accent tokens for first-run, learn, practice, review, mistakes, progress and generation surfaces"
      ]
    },
    {
      "version": "2.1.0",
      "date": "2026-07-30",
      "changes": [
        "Clarified Lucide geometry and proprietary symbols",
        "Changed primary CTA rule from viewport to decision context",
        "Removed automatic system dark-theme behavior; dimmedPaper is manual",
        "Added technical-width exceptions for code, diff and terminal",
        "Refined non-color communication requirements",
        "Added breakpoints, focus, state, editor, terminal, execution, density and touch tokens"
      ]
    },
    {
      "version": "2.0.0",
      "date": "2026-07-30",
      "changes": [
        "Expanded design system for implementation"
      ]
    }
  ],
  "color": {
    "ink": "#17141F",
    "paper": "#FFF4E0",
    "dimmedPaper": "#F6E9CF",
    "panel": "#FFFCF5",
    "dim": "#5E5868",
    "desk": "#F1E4C8",
    "machine": "#141412",
    "machineText": "#E9E5D8",
    "machineRule": "#3A3A34",
    "signal": "#FFD43B",
    "signalInk": "#2B2200",
    "success": "#14804A",
    "warning": "#9A5B00",
    "error": "#C8321F",
    "info": "#3A4FE0",
    "accent": {
      "onboarding": "#00808C",
      "learn": "#3A4FE0",
      "practice": "#6B3FD8",
      "review": "#B25A00",
      "mistakes": "#C8321F",
      "progress": "#14804A",
      "generation": "#B0247A"
    },
    "overlay": "rgba(23,20,31,0.62)",
    "mastery": {
      "0": "#B9B4A8",
      "1": "#9C978D",
      "2": "#77736A",
      "3": "#4E4B45",
      "4": "#252421",
      "5": "#0E0E0C"
    },
    "subjectAccent": {
      "mathematics": "#B69CFF",
      "portuguese": "#FF8FC8",
      "science": "#C4F03A",
      "historyGeography": "#FFA552"
    },
    "surface": {
      "violet": "#B69CFF",
      "pink": "#FF8FC8",
      "lime": "#C4F03A",
      "orange": "#FFA552",
      "sky": "#8FDCFF",
      "yellow": "{color.signal}"
    }
  },
  "state": {
    "disabledOpacity": 0.48,
    "hoverOpacity": 0.92,
    "selectedPattern": "solid-rule",
    "criticalChannels": 2,
    "defaultNonColorChannels": 1
  },
  "focus": {
    "width": "3px",
    "offset": "3px",
    "style": "solid",
    "color": "{color.info}",
    "machineColor": "{color.signal}"
  },
  "typography": {
    "display": {
      "family": "Archivo",
      "weight": 800,
      "tracking": "-0.045em",
      "sizes": {
        "2xl": "64px",
        "xl": "56px",
        "lg": "48px",
        "md": "38px",
        "sm": "28px"
      }
    },
    "body": {
      "family": "Archivo",
      "weights": {
        "regular": 400,
        "semibold": 600,
        "bold": 700
      },
      "sizes": {
        "lg": "17px",
        "md": "16px",
        "sm": "14px"
      },
      "leading": 1.55
    },
    "technical": {
      "family": "JetBrains Mono",
      "weights": {
        "regular": 400,
        "bold": 700
      },
      "sizes": {
        "md": "13px",
        "sm": "12px",
        "xs": "10px"
      },
      "tracking": "0.12em"
    },
    "code": {
      "family": "JetBrains Mono",
      "size": "14px",
      "leading": 1.7
    },
    "scale": {
      "meta": "14px",
      "body": "17px",
      "bodyWide": "18px",
      "lead": "22px",
      "title": "32px",
      "display": "48px",
      "hero": "72px"
    },
    "width": {
      "normal": "100%",
      "semi": "112%",
      "expanded": "125%"
    },
    "displayWeight": 900,
    "readingMeasure": "66ch",
    "readingLeading": 1.55
  },
  "spacing": {
    "1": "2px",
    "2": "4px",
    "3": "6px",
    "4": "8px",
    "5": "10px",
    "6": "12px",
    "8": "16px",
    "10": "20px",
    "12": "24px",
    "16": "32px",
    "20": "40px",
    "24": "48px",
    "32": "64px"
  },
  "border": {
    "hair": "1.5px",
    "rule": "3px",
    "accent": "8px",
    "navActive": "4px"
  },
  "radius": {
    "none": "0px",
    "sm": "6px",
    "md": "10px",
    "learningCard": "18px",
    "interactive": "14px",
    "sheet": "24px"
  },
  "shadow": {
    "structural": "4px 4px 0 {color.ink}",
    "raised": "6px 6px 0 {color.ink}",
    "window": "8px 8px 0 {color.ink}",
    "pressed": "1px 1px 0 {color.ink}"
  },
  "motion": {
    "fast": "120ms",
    "base": "140ms",
    "slow": "180ms",
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "linear": "linear",
    "travelMin": "2px",
    "travelMax": "4px",
    "uiFast": "150ms",
    "ui": "200ms",
    "uiSlow": "250ms",
    "press": "90ms",
    "stamp": "200ms",
    "stampRotation": "-6deg",
    "questionTravel": "24px",
    "easeOut": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "breakpoint": {
    "mobile": "0px",
    "tablet": "768px",
    "desktop": "1200px",
    "wide": "1440px"
  },
  "size": {
    "buttonDefault": "44px",
    "buttonCompact": "32px",
    "inputDefault": "44px",
    "sidebar": "214px",
    "drawer": "360px",
    "paletteMax": "660px",
    "statusbar": "28px",
    "answerMinHeight": "56px",
    "primaryMobileButton": "52px"
  },
  "icon": {
    "sm": "16px",
    "md": "20px",
    "lg": "24px",
    "stroke": "2px",
    "library": "Lucide"
  },
  "touch": {
    "minimum": "44px"
  },
  "density": {
    "compactRow": "32px",
    "defaultRow": "44px",
    "focusGap": "24px",
    "compactAllowedMin": "768px"
  },
  "editor": {
    "background": "{color.machine}",
    "foreground": "{color.machineText}",
    "border": "{color.machineRule}",
    "caret": "{color.signal}",
    "selection": "rgba(245,197,24,0.24)",
    "lineNumber": "#8C887D"
  },
  "terminal": {
    "background": "{color.machine}",
    "foreground": "{color.machineText}",
    "stdout": "{color.machineText}",
    "stderr": "#FF8E7A",
    "system": "#BEB8AA",
    "success": "#7FD1A8",
    "warning": "#E9C66A"
  },
  "execution": {
    "running": "{color.info}",
    "passed": "{color.success}",
    "failed": "{color.error}",
    "timeout": "{color.warning}",
    "idle": "{color.dim}"
  },
  "zIndex": {
    "base": 0,
    "panel": 10,
    "sticky": 20,
    "drawer": 30,
    "modal": 40,
    "palette": 50,
    "toast": 60,
    "tooltip": 70
  },
  "mastery": {
    "0": "○ não visto",
    "1": "◔ introduzido",
    "2": "◑ entendido",
    "3": "◕ praticando",
    "4": "● forte",
    "5": "★ dominado"
  },
  "diff": {
    "added": "rgba(30,111,73,0.16)",
    "removed": "rgba(184,50,32,0.14)",
    "changed": "rgba(245,197,24,0.20)"
  },
  "toast": {
    "width": "360px",
    "durationInfo": "5000ms",
    "durationCritical": "persistent"
  },
  "theme": {
    "systemDarkMode": false,
    "dimmedPaperMode": "manual"
  },
  "navigation": {
    "mobileBottomHeight": "64px"
  },
  "elevation": {
    "structure": {
      "border": "2px",
      "shadow": "none"
    },
    "surface": {
      "border": "2px",
      "shadow": "4px 4px 0 {color.ink}"
    },
    "action": {
      "border": "3px",
      "shadow": "6px 6px 0 {color.ink}",
      "pressTravel": "4px",
      "pressedShadow": "0 0 0 {color.ink}"
    }
  },
  "pattern": {
    "grid": {
      "cell": "24px",
      "line": "1px",
      "color": "rgba(23,20,31,0.06)"
    }
  },
  "layout": {
    "grid": {
      "mobileColumns": 4,
      "mobileMargin": "20px",
      "desktopColumns": 12,
      "gutter": "16px",
      "desktopGutter": "24px",
      "marginColumn": "220px"
    }
  },
  "themes": {
    "vibrante": {
      "base": {
        "color": {
          "paper": "#D4FF4F",
          "dimmedPaper": "#E6FF99",
          "desk": "#C2F03A",
          "panel": "#FFFFFF",
          "dim": "#3A3544",
          "signal": "#FFE135",
          "signalInk": "#17141F",
          "subjectAccent": {
            "mathematics": "#FF7357",
            "science": "#4CC96B",
            "portuguese": "#B08CFF",
            "historyGeography": "#FFD12E"
          },
          "surface": {
            "lime": "#D4FF4F",
            "pink": "#FF9AD5",
            "sky": "#7FD6FF",
            "orange": "#FF9E5E",
            "violet": "#B08CFF"
          }
        },
        "radius": {
          "sm": "8px",
          "md": "12px",
          "interactive": "16px",
          "learningCard": "24px",
          "sheet": "32px"
        },
        "typography": {
          "display": {
            "weight": 900
          },
          "body": {
            "weights": {
              "regular": 500,
              "semibold": 700,
              "bold": 800
            }
          }
        }
      },
      "palettes": {
        "b": {
          "color": {
            "paper": "#C9B8FF",
            "dimmedPaper": "#E2D8FF",
            "desk": "#B6A0FF"
          }
        },
        "c": {
          "color": {
            "paper": "#FFC2A1",
            "dimmedPaper": "#FFE0CF",
            "desk": "#FFAF85"
          }
        }
      }
    }
  }
}
